*,
*::before,
*::after {
    box-sizing: border-box;
}

:root {
    --bg: #fffafb;
    --card: #ffffff;
    --card-soft: #fff7fb;
    --text: #6b2143;
    --text-soft: #8c5873;
    --heading: #a21c5d;
    --primary: #ec4899;
    --primary-dark: #db2777;
    --primary-soft: #fdf2f8;
    --border: #f9c6dd;
    --border-strong: #f4a7cb;
    --shadow: 0 10px 30px rgba(219, 39, 119, 0.08);
    --success-bg: #dcfce7;
    --success-text: #166534;
    --warning-bg: #fef3c7;
    --warning-text: #92400e;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    background:
        radial-gradient(circle at top left, rgba(244, 114, 182, 0.08), transparent 280px),
        radial-gradient(circle at top right, rgba(236, 72, 153, 0.08), transparent 260px),
        var(--bg);
    overflow-x: hidden;
}

img,
svg,
canvas,
video {
    display: block;
    max-width: 100%;
    height: auto;
}

.container {
    /* make container take more of available viewport while keeping a max width */
    width: calc(100% - 48px);
    max-width: 1600px;
    margin: 18px auto 24px;
    padding: 0;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px;
    box-shadow: var(--shadow);
    margin-bottom: 16px;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}

.card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 14px 34px rgba(219, 39, 119, 0.11);
}

h1,
h2,
h3,
h4 {
    margin: 0 0 12px;
    color: var(--heading);
    line-height: 1.3;
    font-weight: 700;
}

h2 {
    font-size: 24px;
}

h3 {
    font-size: 19px;
}

h4 {
    font-size: 18px;
}

p {
    margin: 0 0 10px;
}

.topnav.card {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    padding: 12px 16px;
    background: rgba(255, 245, 250, 0.92);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 12px;
    z-index: 20;
}

.topnav a {
    text-decoration: none;
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 15px;
    padding: 8px 0;
    position: relative;
}

.topnav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 3px;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width .2s ease;
}

.topnav a:hover::after {
    width: 100%;
}

.btn-plain {
    border: 0;
    background: transparent;
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    padding: 8px 0;
}

.msg-ok,
.msg-err {
    border-radius: 14px;
    padding: 12px 14px;
    margin-bottom: 14px;
    font-weight: 600;
}

.msg-ok {
    background: #fff4fa;
    border: 1px solid var(--border-strong);
    color: var(--heading);
}

.msg-err {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    color: #be123c;
}

.muted {
    color: var(--text-soft);
    font-size: 13px;
}

.small {
    color: var(--text-soft);
    font-size: 12px;
}

.grid,
.chart-grid,
.dashboard-plan-grid,
.progress-summary,
.report-grid {
    display: grid;
    gap: 16px;
}

.grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.progress-summary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.dashboard-plan-grid,
.report-grid,
.chart-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.summary-box,
.summary-card {
    background: linear-gradient(180deg, #fff8fb 0%, #ffffff 100%);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    min-width: 0;
}

.summary-title,
.summary-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #b14b78;
    margin-bottom: 8px;
}

.summary-number,
.summary-value {
    font-size: 28px;
    line-height: 1;
    font-weight: 800;
    color: var(--primary-dark);
}

.plan-card {
    min-width: 0;
    padding: 18px;
    background: linear-gradient(180deg, #fff8fb 0%, #ffffff 100%);
}

.plan-status {
    margin: 8px 0 10px;
}

.plan-text,
.report-value,
.task-text {
    line-height: 1.7;
    color: #653147;
    white-space: pre-line;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.chart-card {
    min-height: 430px;
    padding-bottom: 10px;
}

.chart-card canvas {
    width: 100% !important;
    height: 340px !important;
}

.link-pink {
    color: var(--primary-dark);
    text-decoration: none;
    font-weight: 700;
}

.link-pink:hover {
    text-decoration: underline;
}

table,
.report-table,
.todo-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
}

th,
td {
    border-bottom: 1px solid #f8d5e4;
    padding: 12px 10px;
    text-align: left;
    vertical-align: top;
    font-size: 14px;
}

th {
    background: #fff6fb;
    color: var(--heading);
    font-weight: 700;
    font-size: 13px;
}

td {
    color: #68364c;
    word-break: break-word;
    overflow-wrap: anywhere;
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 14px;
}

input,
select,
textarea {
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    padding: 10px 12px;
    font: inherit;
    color: var(--text);
    background: #fff;
    transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(236, 72, 153, 0.14);
    background: #fffefe;
}

textarea {
    min-height: 96px;
    resize: vertical;
}

button {
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: #fff;
    font-weight: 700;
    padding: 10px 16px;
    cursor: pointer;
    transition: transform .16s ease, box-shadow .16s ease, opacity .16s ease;
    box-shadow: 0 8px 18px rgba(236, 72, 153, 0.22);
}

button:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 22px rgba(236, 72, 153, 0.28);
}

button:active {
    transform: translateY(0);
}

.btn-cancel {
    background: #fff;
    color: var(--primary-dark);
    border: 1px solid var(--border-strong);
    box-shadow: none;
}

.check-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.check-box input {
    width: auto;
    transform: scale(1.05);
    accent-color: var(--primary);
}

.status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 8px;
}

.status-success {
    background: var(--success-bg);
    color: var(--success-text);
}

.status-warning {
    background: var(--warning-bg);
    color: var(--warning-text);
}

.week-title {
    margin: 18px 0 10px;
    color: var(--heading);
    font-weight: 700;
}

.task-board {
    background: linear-gradient(180deg, #fff8fb 0%, #fffefe 100%);
    min-width: 0;
}

.task-board-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
}

.task-board-title {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
}

.task-check {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    flex: 0 0 auto;
    margin-top: 2px;
}

.task-email {
    color: var(--text-soft);
    font-size: 12px;
    margin-top: 2px;
}

.task-divider {
    height: 1px;
    background: #f5d2e2;
    margin: 14px 0;
}

.planned-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.task-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.task-check-form {
    margin: 0;
}

.task-circle-label {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
}

.task-circle-label input {
    display: none;
}

.task-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: #fff;
    display: inline-block;
    margin-top: 4px;
    transition: all .2s ease;
}

.task-circle-label input:checked + .task-circle {
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: inset 0 0 0 3px #fff;
}

.task-content {
    flex: 1;
    min-width: 0;
}

.task-text {
    font-size: 15px;
    line-height: 1.6;
}

.task-meta {
    margin-top: 6px;
    font-size: 12px;
    color: #ad4f79;
    line-height: 1.5;
}

.task-add-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: #fff;
    color: var(--primary-dark);
    font-size: 20px;
    line-height: 1;
    box-shadow: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.task-add-btn:hover {
    background: var(--primary-soft);
    box-shadow: none;
}

.todo-done {
    opacity: .72;
}

.todo-done td {
    text-decoration: line-through;
}

.todo-table td:nth-child(3) {
    min-width: 320px;
}

.note-form-card textarea {
    min-height: 90px;
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(104, 22, 60, 0.28);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 999;
    backdrop-filter: blur(2px);
}

.modal-backdrop.show {
    display: flex;
}

.modal-card {
    width: min(640px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: 18px;
    border: 1px solid var(--border-strong);
    box-shadow: 0 20px 44px rgba(114, 29, 72, 0.18);
    padding: 18px;
}

.modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
}

.modal-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: #fff5fa;
    color: var(--primary-dark);
    font-size: 22px;
    font-weight: 700;
    line-height: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 2px 0;
    cursor: pointer;
    box-shadow: none;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
}

.report-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.report-table-wide td {
    line-height: 1.6;
}

.section-title {
    margin-bottom: 10px;
}

.report-info {
    display: grid;
    gap: 14px;
}

.week-block {
    margin-top: 16px;
}

.center {
    text-align: center;
}

.report-view { font-size:16px; line-height:1.6; }
.report-view h2 { font-size:26px; margin-bottom:6px; }
.report-view h3 { font-size:20px; }
.report-view h4 { font-size:18px; }
.report-view .card { font-size:inherit; }

@media (min-width: 1440px) {
    .container {
        /* use a larger max width on very wide screens but still leave small gutters */
        width: calc(100% - 96px);
        max-width: 1800px;
    }

    .card {
        padding: 22px;
    }

    .chart-card {
        min-height: 390px;
    }

    .chart-card canvas {
        height: 310px !important;
    }

    .todo-table td:nth-child(3) {
        min-width: 420px;
    }
}

@media (max-width: 1024px) {
    .container {
        width: calc(100% - 32px);
    }

    .chart-card canvas {
        height: 240px !important;
    }
}

@media (max-width: 900px) {
    .grid,
    .progress-summary,
    .dashboard-plan-grid,
    .chart-grid,
    .report-grid {
        grid-template-columns: 1fr;
    }

    .task-board-top,
    .report-head {
        flex-wrap: wrap;
    }

    .container {
        width: calc(100% - 24px);
        margin: 18px auto 24px;
    }

    .topnav.card {
        top: 8px;
    }
}

@media (max-width: 640px) {
    body {
        font-size: 14px;
    }

    .container {
        width: calc(100% - 16px);
        margin: 14px auto 20px;
    }

    .card {
        padding: 14px;
        border-radius: 14px;
    }

    h2 {
        font-size: 22px;
    }

    h3 {
        font-size: 17px;
    }

    th,
    td {
        padding: 10px 8px;
        font-size: 13px;
    }

    textarea {
        min-height: 86px;
    }

    .chart-card {
        min-height: 300px;
    }

    .chart-card canvas {
        height: 210px !important;
    }

    .summary-number,
    .summary-value {
        font-size: 22px;
    }

    .task-text {
        font-size: 14px;
    }

    .modal-card {
        padding: 14px;
        border-radius: 16px;
    }

    .modal-actions button {
        flex: 1 1 auto;
    }
}

@media print {
    .no-print,
    .topnav,
    .task-add-btn,
    .modal-backdrop {
        display: none !important;
    }

    body {
        background: #fff;
    }

    .container {
        width: 100%;
        margin: 0;
    }

    .card {
        box-shadow: none;
        border: 1px solid #ddd;
    }
}